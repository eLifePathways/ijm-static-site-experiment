title = {FiFoSiM – An integrated tax benefit microsimulation and CGE model for Germany},
author = {Peichl, Andreas and Schaefer, Thilo},
volume = 2,
number = 1,
year = 2009,
month = {jun},
pub_date = {2009-06-30},
