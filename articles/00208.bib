@article {10.34196/ijm.00208,
article_type = {journal},
title = {The Hypothetical Household Tool (HHoT) in EUROMOD: a new instrument for comparative research on tax-benefit policies in Europe},
author = {Hufkens, Tine and Goedemé, Tim and Gasior, Katrin and Leventi, Chrysa and Manios, Kostas and Rastrigina, Olga and Recchia, Pasquale and Sutherland, Holly and Van Mechelen, Natascha and Verbist, Gerlinde},
volume = 12,
number = 3,
year = 2019,
month = {dec},
pub_date = {2019-12-31},
pages = {68-85},
citation = {IJM 2019;12(3):68-85},
doi = {10.34196/ijm.00208},
url = {https://doi.org/10.34196/ijm.00208},
abstract = {This paper introduces the Hypothetical Household Tool (HHoT), a new extension of EUROMOD, the tax-benefit microsimulation model for the European Union. With HHoT, users can easily create their own hypothetical data, which enables them to better understand how policies work for households with specific characteristics. The tool creates unique possibilities for an enhanced analysis of taxes and social benefits in Europe by integrating results from population-based microsimulations and hypothetical household simulations in a single modelling framework. Furthermore, the flexibility of HHoT facilitates an advanced use of hypothetical household simulations to create new comparative policy indicators in the context of multi-country and longitudinal analyses. In this paper, we highlight the main features of HHoT, its strengths and limitations, and illustrate how it can be used for comparative policy analysis.},
keywords = {Microsimulation Model, Hypothetical Household Simulations, European Union},
journal = {IJM},
issn = {1747-5864},
publisher = {International Journal of Microsimulation},
}
