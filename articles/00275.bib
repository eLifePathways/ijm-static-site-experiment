article_type = {journal},
title = {SWITCH: A Tax-Benefit Model for Ireland Linked to Survey and Register Data},
author = {Keane, Claire and Doorley, Karina and Kakoulidou, Theano and O’Malley, Seamus},
volume = 16,
number = 1,
year = 2023,
month = {apr},
pub_date = {2023-04-30},
