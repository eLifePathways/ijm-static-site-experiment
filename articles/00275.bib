citation = {IJM 2023;16(1):65-88},
doi = {10.34196/ijm.00275},
url = {https://doi.org/10.34196/ijm.00275},
abstract = {This paper describes the development and operation of the SWITCH model, a tax-benefit microsimulation model for Ireland which is linked to survey and register data. SWITCH is based on the EUROMOD platform but has important advantages over the Irish component of EUROMOD, including a “current income” concept, detailed information on benefit receipt in the underlying data and the modelling of non-cash benefits. We discuss the process of creating an input dataset, including reweighting and uprating. We validate the model’s simulation of the income distribution with respect to a range of external sources and suggest future improvements.},
keywords = {tax benefit models, income tax, databases, policy analysis},
journal = {IJM},
issn = {1747-5864},
publisher = {International Journal of Microsimulation},
}
