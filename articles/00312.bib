title = {Social Distress and (Some) Relief: Estimating the Impact of Pandemic Job Loss on Poverty in South Africa},
author = {Bassier, Ihsaan and Budlender, Joshua and Goldman, Maya},
volume = 18,
number = 1,
year = 2025,
month = {jan},
pub_date = {2025-01-22},
