@article {10.34196/ijm.00086,
article_type = {journal},
title = {Taxation of married couples in Germany and the UK: One-Earner Couples Make the Difference},
author = {Bach, Stefan and Haan, Peter and Ochmann, Richard},
volume = 6,
number = 3,
year = 2013,
month = {dec},
pub_date = {2013-12-31},
pages = {2-20},
citation = {IJM 2013;6(3):2-20},
doi = {10.34196/ijm.00086},
url = {https://doi.org/10.34196/ijm.00086},
abstract = {A large body of literature points out that joint taxation of married couples with full income splitting (\textit{Ehegattensplitting}) is an important reason for the relatively low labor force participation of married women in Germany. This paper investigates the relative gains of joint taxation for married couples by comparing effective tax burdens for three groups of tax units between Germany and the UK. Using the tax and benefit microsimulation model, EUROMOD, we compare effective average income tax rates for singles, one-earner couples, and two-earner couples in Germany and the UK. Applying the concept of effective tax rates, we go beyond marginal tax rates and account for effects of tax allowances and tax exemptions. We find that effective income tax liabilities are significantly lower for the majority of tax units in Germany compared to the UK, in particular for married couples. This is because married couples are taxed jointly in Germany, whereas the spouses are taxed individually in the UK. The benefits of joint taxation are particularly important for one-earner couples, and they can be found along almost the entire income distribution.},
keywords = {personal income taxation, effective tax progression, family taxation},
journal = {IJM},
issn = {1747-5864},
publisher = {International Journal of Microsimulation},
}
