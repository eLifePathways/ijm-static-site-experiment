@article {10.34196/ijm.00231,
article_type = {journal},
title = {UKMOD – A new tax-benefit model for the four nations of the UK},
author = {Richiardi, Matteo and Collado, Diego and Popova, Daria},
volume = 14,
number = 1,
year = 2021,
month = {apr},
