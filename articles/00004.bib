@article {10.34196/ijm.00004,
article_type = {journal},
title = {Simulating disease transmission dynamics at a multi-scale level},
author = {Hoshen, Moshe B. and Burton, Anthony H. and Bowcock, Themis J. V.},
volume = 1,
number = 1,
year = 2007,
month = {dec},
pub_date = {2007-12-31},
pages = {26-34},
citation = {IJM 2007;1(1):26-34},
doi = {10.34196/ijm.00004},
url = {https://doi.org/10.34196/ijm.00004},
abstract = {We present a model of the global spread of a generic human infectious disease using a Monte Carlo micro-simulation with large-scale parallel-processing. This prototype has been constructed and tested on a model of the entire population of the British Isles. Typical results are presented. A microsimulation of this order of magnitude of population simulation has not been previously attained. Further, an efficiency assessment of processor usage indicates that extension to the global scale is feasible. We conclude that the flexible approach outlined provides the framework for a virtual laboratory capable of supporting public health policy making at a variety of spatial scales.},
keywords = {high-performance computing, global modelling, disease transmission},
journal = {IJM},
issn = {1747-5864},
publisher = {International Journal of Microsimulation},
}
