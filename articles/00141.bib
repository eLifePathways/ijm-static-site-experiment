@article {10.34196/ijm.00141,
article_type = {journal},
title = {Evaluating the quality of gross incomes in SILC: Compare them with fiscal data and re-calibrate them using EUROMOD},
author = {Vandelannoote, Dieter and Decoster, André and Vanheukelom, Toon and Verbist, Gerlinde},
volume = 9,
number = 3,
year = 2016,
month = {dec},
pub_date = {2016-12-31},
pages = {5-34},
citation = {IJM 2016;9(3):5-34},
doi = {10.34196/ijm.00141},
url = {https://doi.org/10.34196/ijm.00141},
abstract = {In this paper, we shed light on the quality of the gross incomes as reported in the Survey on Income and Living Conditions (SILC). This is done in three steps. First, as both net and gross incomes are reported in SILC, implicit tax rates are calculated and evaluated. In a second step, gross incomes from SILC are compared with gross incomes reported on the fiscal form for the same individuals. Finally, we make use of EUROMOD to re-calibrate SILC gross incomes in order to make them consistent with the reported net ones. We find that, on average, fiscally reported gross incomes exceed gross incomes in the SILC survey. It is not clear however whether the re-calibration method (whereby we use an iterative method to construct adjusted SILC gross incomes starting from the observed net ones) is a genuine improvement upon the reported gross income distribution.},
keywords = {SILC (Survey on Income and Living Conditions), IPCAL, EUROMOD, Belgium, gross and net incomes, re-calibrate, iterative method},
journal = {IJM},
issn = {1747-5864},
publisher = {International Journal of Microsimulation},
}
