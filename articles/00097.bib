title = {Microsimulation model projecting small area populations using contextual variables: An application to the Montreal metropolitan area, 2006–2031},
author = {Marois, Guillaume and Bélanger, Alain},
volume = 7,
number = 1,
year = 2014,
month = {apr},
pub_date = {2014-04-30},
