title = {SimPaths: An open-source microsimulation model for life course analysis},
author = {Bronka, Patryk and van de Ven, Justin and Kopasker, Daniel and Katikireddi, Srinivasa Vittal and Richiardi, Matteo},
volume = 18,
number = 1,
year = 2025,
