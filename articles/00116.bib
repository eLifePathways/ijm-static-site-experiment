article_type = {journal},
title = {Modelling the Early life-course (MELC): A Microsimulation Model of Child Development in New Zealand},
author = {Milne, Barry J and Lay-Yee, Roy and McLay, Jessica M and Pearson, Janet and von Randow, Martin and Davis, Peter},
volume = 8,
number = 2,
year = 2015,
month = {aug},
