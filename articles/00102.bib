title = {A geospatial dynamic microsimulation model for household population projections},
author = {Rogers, Susan M. and Rineer, James and Scruggs, Matthew D. and Wheaton, William D. and Cooley, Phillip C. and Roberts, Douglas J. and Wagener, Diane K.},
volume = 7,
