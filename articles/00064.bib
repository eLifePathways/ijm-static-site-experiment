title = {The evaluation of health policies through dynamic microsimulation methods},
author = {Zucchelli, Eugenio and Jones, Andrew M and Rice, Nigel},
volume = 5,
number = 1,
year = 2012,
month = {jun},
pub_date = {2012-06-30},
