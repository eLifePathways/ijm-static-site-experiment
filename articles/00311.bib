article_type = {journal},
title = {Accounting for Behavioral Effects in Microsimulation: A Reduced Form Approach},
author = {Ollonqvist, Joonas and Tervola, Jussi and Pirttilä, Jukka and Thoresen, Thor O},
volume = 17,
number = 3,
year = 2024,
month = {dec},
pub_date = {2024-12-31},
