title = {A microsimulation model of fertility, childbearing, and child well-being},
author = {Thomas, Adam and Karpilow, Quentin and Welti, Kate and Manlove, Jennifer and Cook, Elizabeth},
volume = 10,
number = 2,
year = 2017,
month = {aug},
