title = {IDMOD: An Australian microsimulation model of lifetime economic and social factors in familial intellectual disability},
author = {Schofield, Deborah J and Tan, Owen and Shrestha, Rupendra N and Rajkumar, Radhika and West, Sarah and Rice, Morgan and Kasparian, Nadine and Boyle, Jackie and Christie, Louise and Leffler, Melanie and Murray, Lucinda and Tanton, Robert and Li, Jinjing and Roscioli, Tony and Field, Michael},
volume = 13,
number = 1,
year = 2020,
month = {apr},
pub_date = {2020-04-30},
