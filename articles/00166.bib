@article {10.34196/ijm.00166,
article_type = {journal},
title = {Spatial competition with interacting agents},
author = {Ottino-Loffler, Bertrand and Stonedahl, Forrest and Veetil, Vipin and Wilensky, Uri},
volume = 10,
number = 3,
year = 2017,
month = {dec},
pub_date = {2017-12-31},
pages = {75-91},
citation = {IJM 2017;10(3):75-91},
doi = {10.34196/ijm.00166},
url = {https://doi.org/10.34196/ijm.00166},
abstract = {Using agent-based modeling, we generalize Hotelling’s model of spatial competition with more than two firms in a two-dimensional space. Firms choose both price and location to maximize profits. The principle of minimum differentiation does not hold in general. Local duopolies emerge from the interaction between firms. Firms do not spread uniformly across the two-dimensional space, nor do they all charge the same price. Firms in more competitive locations charge lower prices and generate less profit.},
keywords = {hotelling, price competition, agent-based modeling, D21, D43, D83},
journal = {IJM},
issn = {1747-5864},
publisher = {International Journal of Microsimulation},
}
