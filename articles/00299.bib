article_type = {journal},
title = {Firm Turnover and the Rate of Macro Economic Growth: Simulating the Macroeconomic Effects of Schumpeterian Creative Destruction},
author = {Eliasson, Gunnar and Johansson, Dan and Taymaz, Erol},
volume = 17,
number = 2,
year = 2024,
month = {dec},
pub_date = {2024-12-02},
