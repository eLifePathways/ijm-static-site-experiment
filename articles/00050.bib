@article {10.34196/ijm.00050,
article_type = {journal},
title = {On the Italian ACE and its impact on enterprise performance: A PLS-path modeling analysis},
author = {Balzano, Simona and Oropallo, Filippo and Parisi, Valentino},
volume = 4,
number = 2,
year = 2011,
month = {aug},
pub_date = {2011-08-31},
pages = {14-26},
citation = {IJM 2011;4(2):14-26},
doi = {10.34196/ijm.00050},
url = {https://doi.org/10.34196/ijm.00050},
abstract = {In 1998 Italy introduced a restricted version of an Allowance for Corporate Equity, called Dual Income Tax. Using data integrating Italy’s Institute for Statistics enterprise survey data and company accounts, we explore the effects of the Dual Income Tax on enterprise performance in 1998–2001. Firms benefiting from this allowance are simulated through the DIECOFIS corporate tax microsimulation model. The method to estimate enterprise performance is based on a structural equation model which allows us to compute a composite indicator given specific factors observed from enterprise activity. We find a positive impact of the Dual Income Tax on enterprise performance in that companies benefiting from this allowance outperformed non-eligible ones.},
keywords = {allowance for corporate equity, microsimulation, enterprise performance, PLS path-modeling, structural equation model},
journal = {IJM},
issn = {1747-5864},
publisher = {International Journal of Microsimulation},
}
