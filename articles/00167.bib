title = {Projected population, inequality and social expenditures: The Case of Flanders},
author = {De Blander, Rembert and Schockaert, Ingrid and Decoster, André and Deboosere, Patrick},
volume = 10,
number = 3,
year = 2017,
month = {dec},
pub_date = {2017-12-31},
