---
import { getCollection } from 'astro:content';

interface Props {
  currentPath: string;
  // The legacy site renders the listing at the bottom of the page, with an
  // "All sections" jump link under the title; at >=75em its JS moves the
  // listing up into the jump link's place. We render both placements and
  // switch between them with CSS, so only one is ever displayed.
  placement: 'top' | 'bottom';
}

const { currentPath, placement } = Astro.props;

const entries = (await getCollection('about'))
  .filter((entry) => entry.data.order !== undefined)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const slugToPath: Record<string, string> = {
  'aims-and-scope': '/about',
  'editorial-board': '/about/editorial-board',
  'editorial-policy': '/about/editorial-policy',
  'submission-guidelines': '/about/submission-guidelines',
  'reviewer-notes': '/about/reviewer-notes',
  'call-for-papers': '/about/call-for-papers',
  'ima-prize': '/about/ima-prize',
};
---

{placement === 'top' && (
  <a href="#sections" class="about-menu-link">All sections</a>
)}
<nav
  aria-label="About sections"
  class:list={['about-menu', `about-menu--${placement}`]}
  id={placement === 'bottom' ? 'sections' : undefined}
>
  {placement === 'bottom' && <h2>About sections</h2>}
  <ul>
    {entries.map((entry) => {
      const href = slugToPath[entry.id] ?? `/about/${entry.id}`;
      const hasResponsiveTitle = entry.data.navTitle && entry.data.navTitleShort;
      return (
        <li>
          <a href={href} aria-current={href === currentPath ? 'page' : undefined}>
            {hasResponsiveTitle ? (
              <>
                <span class="nav-title-wide">{entry.data.navTitle}</span>
                <span class="nav-title-short">{entry.data.navTitleShort}</span>
              </>
            ) : (
              entry.data.title
            )}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .about-menu-link {
    display: block;
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-xs);
    margin-block-end: var(--space-s);
    text-align: center;
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-heading);

    &::after {
      content: '\00a0\00bb';
    }
    &:hover {
      color: var(--color-accent);
    }
  }

  .about-menu--top {
    display: none;
    border-bottom: 1px solid var(--color-border);
    padding-block-end: var(--space-xs);
    margin-block-end: var(--space-s);
  }

  .about-menu--bottom {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-m) var(--space-l);
    text-align: center;
  }

  @media (min-width: 75em) {
    .about-menu-link,
    .about-menu--bottom {
      display: none;
    }
    .about-menu--top {
      display: block;
    }
  }

  .about-menu {
    h2 {
      font-size: var(--step-1);
      margin-block-end: var(--space-xs);
    }

    ul {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-2xs) var(--space-m);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    a {
      color: var(--color-accent);
      text-decoration: none;
      font-family: var(--font-heading);
      font-size: var(--step--1);
    }
    a:hover {
      color: var(--color-accent-strong);
    }
    a[aria-current='page'] {
      color: var(--color-ink);
      font-weight: bold;
      text-decoration: underline;
    }

    /* Responsive nav titles: short on narrow, full on wide */
    .nav-title-wide {
      display: none;
    }
    .nav-title-short {
      display: inline;
    }

    @media (min-width: 75em) {
      .nav-title-wide {
        display: inline;
      }
      .nav-title-short {
        display: none;
      }
    }
  }
</style>
