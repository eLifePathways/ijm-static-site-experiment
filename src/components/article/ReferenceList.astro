---
import { googleScholarUrl } from '@/utils/googleScholar';

interface Author {
  type: 'person' | 'group';
  // A group's name is a plain string; a person's is structured.
  name?: string | { preferred: string; index: string };
}

interface Pages {
  first?: string;
  last?: string;
  range?: string;
}

interface Publisher {
  name: string[];
  address?: { formatted: string[] };
}

interface Reference {
  id: string;
  type: string;
  authors?: Author[];
  // Theses name a single `author`; `authors` is then a "n/a" placeholder.
  author?: Author;
  date?: string;
  // journal
  articleTitle?: string;
  journal?: string;
  volume?: string;
  issue?: string;
  pages?: Pages;
  doi?: string;
  // book
  bookTitle?: string;
  publisher?: Publisher;
  edition?: string;
  // book-chapter
  editors?: Author[];
  chapterTitle?: string;
  // conference
  conference?: { name: string[] };
  // web
  title?: string;
  uri?: string;
  accessed?: string;
  // report / thesis / software / preprint
  source?: string;
  // misc
  number?: string;
  pages_raw?: string;
}

interface Props {
  references: Reference[];
}

const { references } = Astro.props;

function authorName(a: Author): string {
  if (typeof a.name === 'string') return a.name;
  return a.name?.index ?? a.name?.preferred ?? '';
}

// "n/a" is a placeholder group author in the source data; the legacy site
// doesn't display it.
function referenceAuthors(ref: Reference): Author[] {
  if (ref.author) return [ref.author];
  return (ref.authors ?? []).filter((a) => a.name !== 'n/a');
}

function authorStr(authors: Author[] | undefined, max = 99): string {
  if (!authors?.length) return '';
  const names = authors.slice(0, max).map(authorName);
  const suffix = authors.length > max ? ' et al' : '';
  return names.join(', ') + suffix;
}

function editorStr(eds: Author[] | undefined): string {
  if (!eds?.length) return '';
  const s = authorStr(eds);
  return eds.length === 1 ? `${s} (Ed.)` : `${s} (Eds.)`;
}

function pageStr(pages: Pages | undefined): string {
  if (!pages) return '';
  return pages.range ?? (pages.first && pages.last ? `${pages.first}–${pages.last}` : (pages.first ?? ''));
}

function pubStr(pub: Publisher | undefined): string {
  if (!pub) return '';
  const loc = pub.address?.formatted?.[0];
  const name = pub.name.join(', ');
  return loc ? `${loc}: ${name}` : name;
}
---

<details id="references" class="article-section article-section--collapsible" open>
  <summary><h2>References</h2></summary>
  <ol class="reference-list">
    {references.map((ref) => (
      <li id={ref.id} class="reference-item">
        {/* Journal article */}
        {ref.type === 'journal' && (
          <span>
            {authorStr(referenceAuthors(ref))} ({ref.date}).{' '}
            {ref.articleTitle && <span set:html={ref.articleTitle} />}.{' '}
            <em>{ref.journal}</em>
            {ref.volume && <>, <strong>{ref.volume}</strong></>}
            {ref.issue && <>({ref.issue})</>}
            {pageStr(ref.pages) && <>, {pageStr(ref.pages)}</>}.
            {ref.doi && <>{' '}<a href={`https://doi.org/${ref.doi}`} target="_blank" rel="noopener">{`https://doi.org/${ref.doi}`}</a></>}
          </span>
        )}

        {/* Book */}
        {ref.type === 'book' && (
          <span>
            {authorStr(referenceAuthors(ref))} ({ref.date}).{' '}
            <em set:html={ref.bookTitle} />.
            {ref.edition && <> {ref.edition} ed.</>}
            {pubStr(ref.publisher) && <> {pubStr(ref.publisher)}.</>}
          </span>
        )}

        {/* Book chapter */}
        {ref.type === 'book-chapter' && (
          <span>
            {authorStr(referenceAuthors(ref))} ({ref.date}).{' '}
            {ref.chapterTitle && <span set:html={ref.chapterTitle} />}.{' '}
            {ref.editors && <>In {editorStr(ref.editors)}, </>}
            <em set:html={ref.bookTitle} />
            {pageStr(ref.pages) && <> (pp. {pageStr(ref.pages)})</>}.
            {pubStr(ref.publisher) && <> {pubStr(ref.publisher)}.</>}
          </span>
        )}

        {/* Conference proceeding */}
        {ref.type === 'conference-proceeding' && (
          <span>
            {authorStr(referenceAuthors(ref))} ({ref.date}).{' '}
            {ref.articleTitle && <span set:html={ref.articleTitle} />}.{' '}
            {ref.conference && <em>{ref.conference.name.join(', ')}</em>}
            {pageStr(ref.pages) && <>, {pageStr(ref.pages)}</>}.
          </span>
        )}

        {/* Web / online source */}
        {ref.type === 'web' && (
          <span>
            {authorStr(referenceAuthors(ref))} ({ref.date}).{' '}
            {ref.title && <span set:html={ref.title} />}.
            {ref.uri && <>{' '}<a href={ref.uri} target="_blank" rel="noopener">{ref.uri}</a></>}
            {ref.accessed && <> (accessed {ref.accessed})</>}.
          </span>
        )}

        {/* Report */}
        {(ref.type === 'report' || ref.type === 'data') && (
          <span>
            {authorStr(referenceAuthors(ref))} ({ref.date}).{' '}
            {ref.title && <em set:html={ref.title} />}
            {/* A report's `source` just repeats its title; for data it's the repository. */}
            {ref.type === 'data' && ref.source && <>{'. '}{ref.source}</>}
            {ref.type === 'report' && pubStr(ref.publisher) && <>{'. '}{pubStr(ref.publisher)}</>}.
            {ref.doi && <>{' '}<a href={`https://doi.org/${ref.doi}`} target="_blank" rel="noopener">{`https://doi.org/${ref.doi}`}</a></>}
          </span>
        )}

        {/* Thesis */}
        {ref.type === 'thesis' && (
          <span>
            {authorStr(referenceAuthors(ref))} ({ref.date}).{' '}
            {ref.title && <em set:html={ref.title} />}.
            {pubStr(ref.publisher) && <> {pubStr(ref.publisher)}.</>}
          </span>
        )}

        {/* Preprint / software */}
        {(ref.type === 'preprint' || ref.type === 'software') && (
          <span>
            {authorStr(referenceAuthors(ref))} ({ref.date}).{' '}
            {ref.title && <em set:html={ref.title} />}.
            {ref.source && <>{' '}{ref.source}.</>}
            {ref.doi && <>{' '}<a href={`https://doi.org/${ref.doi}`} target="_blank" rel="noopener">{`https://doi.org/${ref.doi}`}</a></>}
          </span>
        )}

        {/* Fallback for unknown types */}
        {ref.type === 'unknown' && (
          <span>
            {authorStr(referenceAuthors(ref))}
            {ref.date && <> ({ref.date})</>}.
            {(ref.articleTitle || ref.title || ref.bookTitle) && (
              <> <span set:html={ref.articleTitle ?? ref.title ?? ref.bookTitle} />.</>
            )}
          </span>
        )}

        {googleScholarUrl(ref) && (
          <a class="reference-item__scholar" href={googleScholarUrl(ref)} target="_blank" rel="noopener">Google Scholar</a>
        )}
      </li>
    ))}
  </ol>
</details>

<style>
  .reference-list {
    padding-inline-start: var(--space-l);
    margin-block-start: var(--space-m);

    li {
      margin-block-end: var(--space-s);
      padding-inline-start: var(--space-2xs);
    }
  }

  .reference-item__scholar {
    display: block;
    font-size: var(--step--1);
  }
</style>
