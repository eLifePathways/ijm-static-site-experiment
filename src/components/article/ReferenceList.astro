---
import { googleScholarUrl, referenceTitle } from '@/utils/googleScholar';
import { referenceHref } from '@/utils/referenceLinks';

interface Author {
  type: 'person' | 'group';
  // A group's name is a plain string; a person's is structured.
  name?: string | { preferred: string; index: string };
}

interface Pages {
  first?: string;
  last?: string;
  range?: string;
}

interface Publisher {
  name: string[];
  address?: { formatted: string[] };
}

interface Reference {
  id: string;
  type: string;
  authors?: Author[];
  // Theses name a single `author`; `authors` is then a "n/a" placeholder.
  author?: Author;
  authorsEtAl?: boolean;
  date?: string;
  // journal
  articleTitle?: string;
  journal?: string;
  volume?: string;
  issue?: string;
  // A page range, or free text such as an article number.
  pages?: Pages | string;
  doi?: string;
  // book
  bookTitle?: string;
  publisher?: Publisher;
  edition?: string;
  // book-chapter
  editors?: Author[];
  chapterTitle?: string;
  // conference
  conference?: { name: string[] };
  // web
  title?: string;
  uri?: string;
  accessed?: string;
  // report / thesis / software / preprint
  source?: string;
  // misc
  number?: string;
  pages_raw?: string;
}

interface Props {
  references: Reference[];
}

const { references } = Astro.props;

function authorName(a: Author): string {
  if (typeof a.name === 'string') return a.name;
  return a.name?.index ?? a.name?.preferred ?? '';
}

// "n/a" is a placeholder group author in the source data; the legacy site
// doesn't display it.
function referenceAuthors(ref: Reference): Author[] {
  if (ref.author) return [ref.author];
  return (ref.authors ?? []).filter((a) => a.name !== 'n/a');
}

function authorStr(authors: Author[] | undefined, max = 99): string {
  if (!authors?.length) return '';
  const names = authors.slice(0, max).map(authorName);
  const suffix = authors.length > max ? ' et al' : '';
  return names.join(', ') + suffix;
}

function editorStr(eds: Author[] | undefined): string {
  if (!eds?.length) return '';
  const s = authorStr(eds);
  return eds.length === 1 ? `${s} (Ed.)` : `${s} (Eds.)`;
}

function pageStr(pages: Pages | string | undefined): string {
  if (!pages) return '';
  if (typeof pages === 'string') return pages;
  return pages.range ?? (pages.first && pages.last ? `${pages.first}–${pages.last}` : (pages.first ?? ''));
}

function pubStr(pub: Publisher | undefined): string {
  if (!pub) return '';
  const loc = pub.address?.formatted?.[0];
  const name = pub.name.join(', ');
  return loc ? `${loc}: ${name}` : name;
}
---

<details id="references" class="article-section article-section--collapsible" open>
  <summary><h2>References</h2></summary>
  <ol class="reference-list">
    {references.map((ref) => (
      <li id={ref.id} class="reference-item">
        {/* Same order as the legacy site: title, authors (year), details, DOI, Google Scholar. */}
        {referenceHref(ref) ? (
          <a class="reference-item__title" href={referenceHref(ref)} target="_blank" rel="noopener" set:html={referenceTitle(ref)} />
        ) : (
          <span class="reference-item__title" set:html={referenceTitle(ref)} />
        )}

        <span class="reference-item__authors">
          {authorStr(referenceAuthors(ref))}
          {ref.authorsEtAl && <> et al.</>}
          {ref.date && <> ({ref.date})</>}
        </span>

        {/* Journal article */}
        {ref.type === 'journal' && (
          <span class="reference-item__origin">
            <em>{ref.journal}</em>
            {ref.volume && <>, <strong>{ref.volume.trim()}</strong></>}
            {ref.issue && <>({ref.issue})</>}
            {pageStr(ref.pages) && <>, {pageStr(ref.pages)}</>}.
          </span>
        )}

        {/* Book */}
        {ref.type === 'book' && (ref.edition || pubStr(ref.publisher)) && (
          <span class="reference-item__origin">
            {ref.edition && <>{ref.edition} ed. </>}
            {pubStr(ref.publisher) && <>{pubStr(ref.publisher)}.</>}
          </span>
        )}

        {/* Book chapter */}
        {ref.type === 'book-chapter' && (
          <span class="reference-item__origin">
            {ref.editors && <>In {editorStr(ref.editors)}, </>}
            <em set:html={ref.bookTitle} />.
            {pubStr(ref.publisher) && <> {pubStr(ref.publisher)}.</>}
            {pageStr(ref.pages) && <> pp. {pageStr(ref.pages)}.</>}
          </span>
        )}

        {/* Conference proceeding */}
        {ref.type === 'conference-proceeding' && ref.conference && (
          <span class="reference-item__origin">
            <em>{ref.conference.name.join(', ')}</em>
            {pageStr(ref.pages) && <>, {pageStr(ref.pages)}</>}.
          </span>
        )}

        {/* Web / online source */}
        {ref.type === 'web' && ref.accessed && (
          <span class="reference-item__origin">Accessed {ref.accessed}.</span>
        )}

        {/* Report / thesis: a report's `source` just repeats its title, so show the publisher */}
        {(ref.type === 'report' || ref.type === 'thesis') && pubStr(ref.publisher) && (
          <span class="reference-item__origin">{pubStr(ref.publisher)}.</span>
        )}

        {/* Data / preprint / software: `source` is the repository or series */}
        {(ref.type === 'data' || ref.type === 'preprint' || ref.type === 'software') && ref.source && (
          <span class="reference-item__origin">{ref.source}.</span>
        )}

        {ref.doi && (
          <a class="reference-item__doi" href={`https://doi.org/${ref.doi}`} target="_blank" rel="noopener">{`https://doi.org/${ref.doi}`}</a>
        )}

        {googleScholarUrl(ref) && (
          <a class="reference-item__scholar" href={googleScholarUrl(ref)} target="_blank" rel="noopener">Google Scholar</a>
        )}
      </li>
    ))}
  </ol>
</details>

<style>
  .reference-list {
    padding-inline-start: var(--space-l);
    margin-block-start: var(--space-m);

    li {
      margin-block-end: var(--space-s);
      padding-inline-start: var(--space-2xs);
    }
  }

  .reference-item__title,
  .reference-item__authors,
  .reference-item__origin,
  .reference-item__doi,
  .reference-item__scholar {
    display: block;
  }

  .reference-item__title {
    font-weight: bold;
  }

  .reference-item__scholar {
    font-size: var(--step--1);
  }
</style>
