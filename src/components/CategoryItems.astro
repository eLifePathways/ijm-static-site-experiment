---
interface Item {
  label: string;
  href: string;
}
interface Props {
  items: Item[];
  columns: number;
}
const { items, columns } = Astro.props;
---

<ol class="category-items" style={`column-count: ${columns}`}>
  {items.map((item) => (
    <li><a href={item.href}>{item.label}</a></li>
  ))}
</ol>

<style>
  .category-items {
    column-gap: var(--space-l);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .category-items li {
    break-inside: avoid;
    margin: 0;
  }

  .category-items a {
    font-family: var(--font-heading);
    color: var(--color-ink);
    text-decoration: none;
  }

  .category-items a:hover {
    color: var(--color-accent);
  }
</style>
